<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:padding="16dp">

        <TextView
            android:layout_columnSpan="2"
            android:text="@string/stats_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_columnSpan="2"
            android:text="@string/stats_total"
            android:textSize="16sp"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvStatsTotal"
            android:layout_columnSpan="2"
            android:text="0.00 руб."
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_columnSpan="2"
            android:text="@string/stats_count"
            android:textSize="16sp"
            android:paddingTop="16dp" />

        <TextView
            android:id="@+id/tvStatsCount"
            android:layout_columnSpan="2"
            android:text="0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <View
            android:layout_columnSpan="2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_columnSpan="2"
            android:text="@string/budget_title"
            android:textSize="16sp"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvCurrentBudget"
            android:layout_columnSpan="2"
            android:text=""
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingTop="4dp" />

        <EditText
            android:id="@+id/etBudget"
            android:layout_columnSpan="2"
            android:layout_gravity="fill"
            android:hint="@string/budget_hint"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:minHeight="48dp"/>

        <Button
            android:id="@+id/btnSaveBudget"
            android:layout_columnSpan="2"
            android:layout_gravity="fill"
            android:text="@string/budget_save"
            android:layout_marginTop="8dp" />

    </GridLayout>
</ScrollView>